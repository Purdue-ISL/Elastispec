    ((PaperCut_Application_Server, *) -> (Google_Authentication_Services, 443) on tcp)

def DirectoryandAuthenticationServices_SigninwithMicrosoftSpec as
    ((PaperCut_Application_Server, *) -> (Microsoft_Graph_API, 443) on tcp) AND
    ((PaperCut_Application_Server, *) -> (Microsoft_Authentication_Services, 443) on tcp)

def DirectoryandAuthenticationServicesSpec as
    DirectoryandAuthenticationServices_GoogleCloudDirectorySpec OR
    DirectoryandAuthenticationServices_AzureActiveDirectorywithSecureLDAPSpec OR
    DirectoryandAuthenticationServices_AzureActiveDirectorywithMicrosoftGraphSpec OR
    DirectoryandAuthenticationServices_LDAPDirectoryServiceSpec OR
    DirectoryandAuthenticationServices_ActiveDirectorySpec OR
    DirectoryandAuthenticationServices_SigninwithGoogleSpec OR
    DirectoryandAuthenticationServices_SigninwithMicrosoftSpec

