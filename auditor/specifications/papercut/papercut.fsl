def PaperCutCloudServices_PaperCutGrowsSpec as
    ((PaperCut_Application_Server, *) -> (PaperCut_Grows, 443) on tcp)

def PaperCutCloudServicesSpec as
    PaperCutCloudServices_GlobalEntitlementsServiceSpec? AND
    PaperCutCloudServices_PaperCutMFCloudServicesIntegratedScanningSpec? AND
    PaperCutCloudServices_PaperCutGrowsSpec?

def ComponentServices_IntegratedScanning_Self_HostedDocumentProcessingSpec as
    ((PaperCut_Application_Server, *) -> (Self_Hosted_Document_Processing_Server, 9181) on tcp) AND
    ((Self_Hosted_Document_Processing_Server, *) -> (PaperCut_OCR_Update_Service, 443) on tcp)

