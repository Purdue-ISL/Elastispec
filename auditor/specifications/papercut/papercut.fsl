def MainApplicationServerPortsSpec as
    ((PaperCut_Internal_Clients, *) -> (PaperCut_Application_Server, 9191) on tcp) AND
    ((PaperCut_Internal_Clients, *) -> (PaperCut_Application_Server, 9192) on tcp) AND
    ((Embedded_MFDs, *) -> (PaperCut_Application_Server, 9193) on tcp) AND
    ((PaperCut_Application_Server, *) -> (Global_Entitlements_Service, 443) on tcp)?

def CardReaders_ElatecTWN3ReaderandTCPConverterSpec as
    ((PaperCut_Application_Server, *) -> (Elatec_TWN3_Reader_and_TCP_Converter, 7778) on tcp)

def CardReaders_RFIDeasLantronixSpec as
    ((PaperCut_Application_Server, *) -> (RFIDeas_Lantronix, 10001) on tcp)

def CardReaders_RFIdeasEthernet241Spec as
    ((PaperCut_Application_Server, *) -> (RFIdeas_Ethernet_241, 2000) on tcp)

def CardReadersSpec as
    CardReaders_ElatecTWN3ReaderandTCPConverterSpec OR
    CardReaders_RFIDeasLantronixSpec OR
    CardReaders_RFIdeasEthernet241Spec

def ExternalDatabaseSpec as
    ((PaperCut_Application_Server, *) -> (Oracle_Database, 1521) on tcp) OR
    ((PaperCut_Application_Server, *) -> (Microsoft_SQL_Server, 1433) on tcp) OR
    ((PaperCut_Application_Server, *) -> (Microsoft_SQL_Server_Express, 1450) on tcp) OR
    ((PaperCut_Application_Server, *) -> (MySQL_Database, 3306) on tcp) OR
    ((PaperCut_Application_Server, *) -> (PostgreSQL_Database, 5432) on tcp)

