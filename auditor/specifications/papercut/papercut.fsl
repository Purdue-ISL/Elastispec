    ((PaperCut_Application_Server, *) -> (Google_Cloud_Directory, 636) on tcp)

def DirectoryandAuthenticationServices_AzureActiveDirectorywithSecureLDAPSpec as
    ((PaperCut_Application_Server, *) -> (Azure_Active_Directory, 636) on tcp)

def DirectoryandAuthenticationServices_AzureActiveDirectorywithMicrosoftGraphSpec as
