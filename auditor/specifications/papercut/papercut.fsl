    ((PaperCut_Application_Server, *) -> (LDAP_Directory_Service, 389) on tcp)

def DirectoryandAuthenticationServices_ActiveDirectorySpec as
    ((PaperCut_Application_Server, *) -> (Active_Directory, 445) on tcp, udp) AND
    ((PaperCut_Application_Server, *) -> (Active_Directory, 88) on tcp, udp) AND
    ((PaperCut_Application_Server, *) -> (Active_Directory, 389) on udp) AND
    ((PaperCut_Application_Server, *) -> (Active_Directory, 53) on tcp, udp) AND
    ((PaperCut_Application_Server, *) -> (Active_Directory, 135) on tcp) AND
    ((PaperCut_Application_Server, *) -> (Active_Directory, 49152-65535) on tcp)

