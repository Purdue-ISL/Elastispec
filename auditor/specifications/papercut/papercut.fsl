def PaperCutFirewallSpec as
    MainApplicationServerPortsSpec AND
    CardReadersSpec? AND
    ExternalDatabaseSpec AND
    DirectoryandAuthenticationServicesSpec AND
    PaperCutCloudServicesSpec? AND
    ComponentServicesSpec? AND
    PrintDeployFirewallRulesSpec? AND
    MobilityPrintFirewallRulesSpec? AND
    Multi_FunctionDeviceIntegrationSpec AND
    PaperCutConnectorforMicrosoftUniversalPrintSpec?
