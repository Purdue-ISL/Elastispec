    ((PRTG_Core_Server, *) -> (PRTG_Report_Generation_Service, 8085) on tcp)

def PortsUsedinOtherContexts_UpdatecheckanddownloadSpec as
    ((PRTG_Core_Server, *) -> (Paessler_Update_and_Activation_Server, 80) on tcp)

def PortsUsedinOtherContextsSpec as
    PortsUsedinOtherContexts_ActiveDirectoryintegrationSpec? AND
    PortsUsedinOtherContexts_Auto_updateandactivationSpec? AND
    PortsUsedinOtherContexts_ClustercommunicationSpec? AND
    PortsUsedinOtherContexts_IncomingprobeconnectionsSpec? AND
    PortsUsedinOtherContexts_Multi_platformprobeandPRTGcoreserverSpec? AND
    PortsUsedinOtherContexts_NotificationsSpec? AND
    PortsUsedinOtherContexts_PRTGapplicationserverandPRTGcoreserverSpec AND
    PortsUsedinOtherContexts_PRTGCloudSpec? AND
    PortsUsedinOtherContexts_PRTGMultiBoardFileTransferSpec? AND
    PortsUsedinOtherContexts_PRTGwebserverSpec AND
    PortsUsedinOtherContexts_RemoteprobesandPRTGcoreserverSpec? AND
    PortsUsedinOtherContexts_ReportgenerationSpec? AND
    PortsUsedinOtherContexts_UpdatecheckanddownloadSpec?

def PRTGFirewallSpec as
    PortsUsedbySensorsSpec AND PortsUsedinOtherContextsSpec
