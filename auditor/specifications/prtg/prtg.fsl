def PortsUsedinOtherContexts_PRTGwebserverSpec as
    (((User_Workstation, *) -> (PRTG_Web_Server, 443, 8443) on tcp) OR
    ((User_Workstation, *) -> (PRTG_Web_Server, 80, 8080) on tcp)) OR
    (((PRTG_Desktop_App, *) -> (PRTG_Web_Server, 443, 8443) on tcp) OR
    ((PRTG_Desktop_App, *) -> (PRTG_Web_Server, 80, 8080) on tcp)) OR
    (((PRTG_MultiBoard_App, *) -> (PRTG_Web_Server, 443, 8443) on tcp) OR
    ((PRTG_MultiBoard_App, *) -> (PRTG_Web_Server, 80, 8080) on tcp)) OR
    (((PRTG_Mobile_App, *) -> (PRTG_Web_Server, 443, 8443) on tcp) OR
    ((PRTG_Mobile_App, *) -> (PRTG_Web_Server, 80, 8080) on tcp))

